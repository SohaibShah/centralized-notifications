# --- Secrets & credentials — never commit these ---
.env
.env.*
!.env.example
credentials.json
token.json
service-account*.json
*.pem
*.key
id_rsa
id_rsa.pub

# --- Dependencies ---
node_modules/
.pnpm-store/

# --- Vite dep pre-bundle cache (regenerated on dev start) ---
**/.vite/

# --- Python tooling venvs (e.g. docs .docx generation) ---
docs/.venv/
.venv/

# --- VitePress docs site (generated) ---
docs/.vitepress/cache/
docs/.vitepress/dist/

# --- Generated docs artifacts (rebuild from source; not committed) ---
# architecture.html is regenerated from architecture.md by docs/scripts/render_architecture.py
docs/architecture.html

# --- Build output ---
dist/
build/
.output/
*.tsbuildinfo

# --- Tests ---
coverage/
playwright-report/
test-results/
.playwright-mcp/

# --- Logs ---
*.log
npm-debug.log*
pnpm-debug.log*

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# --- Local Claude Code state (personal, not shared) ---
.claude/settings.local.json
CLAUDE.local.md

# --- Visual brainstorming companion scratch (local, not shared) ---
.superpowers/

# --- Non-source scratch/tooling cruft (keep the repo to source + agent config) ---
# VS Code "VSCode Counter" line-count reports
.VSCodeCounter/
# Stray root-level screenshots (real UI assets live under a package's src/, not the repo root)
/*.png
/*.jpg
/*.jpeg
# Ad-hoc PR-notes scratch files (write the description in the PR, not a committed file)
PR_NOTES_*.md
# Redundant agent-skills mirror + its lockfile — the live skills live under .claude/
.agents/
skills-lock.json

# --- Local dev data ---
*.sqlite
*.rdb
docker-data/
Software Requirements Specification Template.docx
~$S - Centralized Notification System - 2026-07-01.docx
SRS - Centralized Notification System - 2026-07-01.docx
SRS - Centralized Notification System - 2026-07-02.docx
